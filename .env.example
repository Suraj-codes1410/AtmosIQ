# Platform Configuration
PROJECT_NAME=atmosIQ
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atmosiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atmosiq_db

# pgAdmin Settings
PGADMIN_EMAIL=admin@atmosiq.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# MLflow Settings
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=delhi_aqi_attribution

# FastAPI Service Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Spring Backend Settings
SERVER_PORT=8080

# Spring AI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# Vector Store / RAG Configuration
VECTOR_STORE_TYPE=pgvector
EMBEDDING_MODEL=text-embedding-3-small
