            "train_years": [
                2020,
                2021,
                2022
            ],
            "eval_year": 2023
        },
        {
            "fold": 3,
            "train_years": [
                2020,
                2021,
                2022,
                2023
            ],
            "eval_year": 2024
        }
    ],
    "rf_base_params": {
        "n_estimators": 400,
        "max_depth": 9,
        "min_samples_split": 4,
        "min_samples_leaf": 5,
        "max_features": 0.7
    },
    "high_stability_threshold": 0.9,
    "moderate_stability_threshold": 0.7,
    "near_zero_epsilon": 0.05,
    "additivity_tolerance": 0.05,
    "counterfactual_scenarios": [
        {
            "scenario_name": "biomass_low",
            "group": "biomass_burning",
            "method": "q25_reference",
