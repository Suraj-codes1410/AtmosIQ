            "description": "Reduce biomass burning indicators to 25th percentile background levels."
        },
        {
            "scenario_name": "biomass_median",
            "group": "biomass_burning",
            "method": "q50_reference",
            "quantile": 0.5,
            "description": "Set biomass burning indicators to median 50th percentile levels."
        },
        {
            "scenario_name": "biomass_high",
            "group": "biomass_burning",
            "method": "q75_reference",
            "quantile": 0.75,
            "description": "Simulate elevated stubble burning fire activity at 75th percentile."
        },
        {
            "scenario_name": "wind_stagnant",
            "group": "wind_ventilation",
            "method": "q25_reference",
            "quantile": 0.25,
            "description": "Set ventilation features to low surface wind speed / poor ventilation (25th percentile)."
        },
        {
            "scenario_name": "wind_dispersion",
            "group": "wind_ventilation",
            "method": "q75_reference",
            "quantile": 0.75,
            "description": "Set ventilation features to strong dispersion reference state (75th percentile)."
        },
        {
            "scenario_name": "meteorology_normal",
            "group": "meteorology",
            "method": "q50_reference",
            "quantile": 0.5,
            "description": "Replace meteorological features with median historical conditions."
        },
        {
            "scenario_name": "combined_biomass_wind",
            "group": "multi_group",
            "groups": [
                "biomass_burning",
                "wind_ventilation"
            ],
            "method": "combined_favorable",
            "description": "Combine low biomass burning (Q25) with high ventilation dispersion (Q75)."
        },
        {
            "scenario_name": "combined_all_favorable",
            "group": "multi_group",
            "groups": [
                "biomass_burning",
                "wind_ventilation",
                "meteorology"
            ],
            "method": "all_favorable",
            "description": "Combine low biomass burning (Q25), high ventilation (Q75), and median weather (Q50)."
        }
    ]
