# AtmosIQ Spring Boot Environment Variables Example Template
# DO NOT COMMIT REAL API KEYS OR PRODUCTION PASSWORDS

# Server Configuration
SERVER_PORT=8080

# PostgreSQL & pgvector Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atmosiq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atmosiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring AI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
SPRING_AI_OPENAI_CHAT_MODEL=gpt-4o

# Certified FastAPI Inference Service Configuration
ATMOSIQ_FASTAPI_BASE_URL=http://localhost:8000
ATMOSIQ_FASTAPI_CONNECT_TIMEOUT=5000
ATMOSIQ_FASTAPI_READ_TIMEOUT=10000
ATMOSIQ_EXPECTED_MODEL_ID=AtmosIQ_DL_TCN_CAL07_25_PRODUCTION_v1.0.0
ATMOSIQ_EXPECTED_MODEL_SHA256=fdc99f7ca4410f3d577e52718e35c956c97f368cd91a8b7f505ee23824085bac
ATMOSIQ_FAIL_ON_MODEL_MISMATCH=true

# Orchestration & Tool Allowlist Configuration
ATMOSIQ_DEFAULT_HORIZON=24h
ATMOSIQ_ENFORCE_TOOL_ALLOWLIST=true
